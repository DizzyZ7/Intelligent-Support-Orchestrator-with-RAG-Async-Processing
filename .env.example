# OpenAI
OPENAI_API_KEY=your_sk_key_here

# Zendesk
ZENDESK_SUBDOMAIN=your_subdomain
ZENDESK_EMAIL=admin@example.com
ZENDESK_API_TOKEN=your_token

# Infrastructure (defaults for docker-compose)
REDIS_URL=redis://redis:6379/0
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Required secret for incoming ticket webhooks (set a long random value)
WEBHOOK_SECRET=replace_with_random_secret
